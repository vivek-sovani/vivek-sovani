<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WindowsMobileLauncher" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Background -->
        <item name="android:windowBackground">@color/wp_background</item>
        <item name="android:colorBackground">@color/wp_background</item>

        <!-- Colors -->
        <item name="colorPrimary">@color/wp_accent_blue</item>
        <item name="colorPrimaryVariant">@color/wp_accent_blue</item>
        <item name="colorOnPrimary">@color/wp_white</item>
        <item name="colorSecondary">@color/wp_accent_cyan</item>
        <item name="colorOnSecondary">@color/wp_white</item>
        <item name="colorSurface">@color/wp_surface</item>
        <item name="colorOnSurface">@color/wp_white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/wp_background</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/wp_text_primary</item>
        <item name="android:textColorSecondary">@color/wp_text_secondary</item>
        <item name="android:textColorHint">@color/wp_text_hint</item>

        <!-- Ripple/selection -->
        <item name="android:colorControlHighlight">#40FFFFFF</item>

        <!-- Window animations -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation.WP</item>
    </style>

    <style name="WPAlertDialog" parent="@android:style/Theme.DeviceDefault.Dark.Dialog.Alert">
        <item name="android:background">@color/wp_surface</item>
    </style>

    <style name="WindowAnimation.WP" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_up</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_down</item>
    </style>

</resources>
