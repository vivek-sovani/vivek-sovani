<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000">

    <androidx.cardview.widget.CardView
        android:id="@+id/optionsCard"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/wp_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- Tile name -->
            <TextView
                android:id="@+id/tvTileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-light"
                android:background="@color/wp_accent" />

            <!-- Size section label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="resize"
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:fontFamily="sans-serif-light" />

            <!-- Size visual swatches row 1: Small + Medium -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/btnSizeSmall"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:background="#22FFFFFF"
                    android:clickable="true"
                    android:focusable="true">
                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:background="@color/wp_accent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="6dp"
                        android:text="small"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-light" />
                </FrameLayout>

                <View android:layout_width="8dp" android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/btnSizeMedium"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:background="#22FFFFFF"
                    android:clickable="true"
                    android:focusable="true">
                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@color/wp_accent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="6dp"
                        android:text="medium"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-light" />
                </FrameLayout>

            </LinearLayout>

            <!-- Size visual swatches row 2: Wide + Large -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:id="@+id/btnSizeWide"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:background="#22FFFFFF"
                    android:clickable="true"
                    android:focusable="true">
                    <View
                        android:layout_width="54dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:background="@color/wp_accent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="6dp"
                        android:text="wide"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-light" />
                </FrameLayout>

                <View android:layout_width="8dp" android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/btnSizeLarge"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:background="#22FFFFFF"
                    android:clickable="true"
                    android:focusable="true">
                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@color/wp_accent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="6dp"
                        android:text="large"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-light" />
                </FrameLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />

            <!-- Unpin -->
            <Button
                android:id="@+id/btnUnpin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="unpin from Start"
                android:textColor="#FF4444"
                android:textSize="14sp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:fontFamily="sans-serif-light" />

            <!-- Cancel -->
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="cancel"
                android:textColor="#88FFFFFF"
                android:textSize="14sp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:fontFamily="sans-serif-light" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
